#!/usr/bin/env bash
#
# ci-local: run a GitHub Actions workflow's steps on this machine, in Linux,
# without touching the development stack. See README.md.
#
# The project describes its plan in `ci-local.config.sh` at the repository
# root (or the file named by CI_LOCAL_CONFIG). This file is the engine: options,
# the Linux runner, running the plan, the summary and the cleanup.
#
# Bash 3.2 compatible (the one macOS ships): no associative arrays, and every
# expansion of a possibly empty array is guarded for `set -u`.

set -euo pipefail

CI_LOCAL_VERSION="0.4.0"
NL=$'\n'
CI_LOCAL_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd -P)"

# ------------------------------------------------------------ the project

find_repo() {
  local dir
  dir="$(pwd -P)"
  while [[ "$dir" != / ]]; do
    if [[ -f "$dir/${CI_LOCAL_CONFIG:-ci-local.config.sh}" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

die_usage() {
  echo "ci-local: $*" >&2
  echo "Try: ci-local --help" >&2
  exit 2
}

# ------------------------------------------------- the configuration API
#
# The config sets these variables and calls these functions. Everything that
# starts with `ci_` or `CI_` is the engine's; the project's own helpers should
# use another prefix.

CI_PROJECT=""          # prefix of every container, network, volume and image (required)
CI_JOBS=()             # names --only selects from (required)
CI_NETWORK=""          # the network the runner joins; default: $CI_PROJECT
CI_RUNNER_DOCKERFILE="" # optional, relative to the repo: FROM ${CI_LOCAL_BASE}
CI_HIDE_FILES=(.env .env.local)
CI_RUNNER_ARGS=()      # extra `docker run` arguments for the runner
CI_WORKFLOW=".github/workflows/ci.yml"

PLAN_KINDS=()
PLAN_NAMES=()
PLAN_JOBS=()
PLAN_TAGS=()
PLAN_TIMEOUTS=()
PLAN_DEVIATES=() # why a step runs another command than its workflow step
PLAN_ENVS=()   # newline-separated KEY=VALUE
PLAN_PASS=()   # newline-separated variable names taken from the host
PLAN_ARGS=()   # host steps: the arguments, separated by US (\037)
PLAN_CMDS=()

ENV_SET_NAMES=()
ENV_SET_VALUES=()  # newline-separated KEY=VALUE, parallel to ENV_SET_NAMES

NOT_MIRRORED_NAMES=()
NOT_MIRRORED_REASONS=()

# ci_env NAME KEY=VALUE...   Defines (or extends) a named set of variables.
ci_env() {
  local name=$1 i
  shift
  for i in ${ENV_SET_NAMES[@]+"${!ENV_SET_NAMES[@]}"}; do
    if [[ "${ENV_SET_NAMES[$i]}" == "$name" ]]; then
      local entry
      for entry in "$@"; do ENV_SET_VALUES[i]+="$entry"$'\n'; done
      return 0
    fi
  done
  local joined="" entry
  for entry in "$@"; do joined+="$entry"$'\n'; done
  ENV_SET_NAMES+=("$name")
  ENV_SET_VALUES+=("$joined")
}

env_set() {
  local i
  for i in ${ENV_SET_NAMES[@]+"${!ENV_SET_NAMES[@]}"}; do
    [[ "${ENV_SET_NAMES[$i]}" != "$1" ]] || { printf '%s' "${ENV_SET_VALUES[$i]}"; return 0; }
  done
  echo "ci-local: no environment set named '$1' (ci_env)" >&2
  exit 2
}

# ci_not_mirrored "Workflow step name" "why, and what runs instead"
ci_not_mirrored() {
  NOT_MIRRORED_NAMES+=("$1")
  NOT_MIRRORED_REASONS+=("$2")
}

# ci_step KIND NAME [options] COMMAND [ARGS...]
#   KIND box   COMMAND is a shell script run in the runner, from the repo root,
#              with `bash -eo pipefail` as GitHub runs a `run:` step.
#   KIND host  COMMAND is a function of the config, run on this machine with
#              ARGS, in a subshell with `set -e` in force.
#   --job J1,J2   only when one of these jobs is selected (default: always)
#   --env SET     add a set defined with ci_env (repeatable)
#   --set K=V     add one variable (repeatable)
#   --pass NAME   pass a variable from this machine's environment, by name only,
#                 so its value is never written into the container (repeatable)
#   --timeout S   kill the step after S seconds (box steps)
#   --tag TAG     a tag --skip can name (repeatable)
#   --deviates R  a box step that stands for the workflow step of the same
#                 name (or first command line) but runs another command on
#                 purpose, for reason R; the parity check accepts it by name
ci_step() {
  [[ $# -ge 3 ]] || { echo "ci_step: KIND NAME COMMAND required" >&2; exit 2; }
  local kind=$1 name=$2 job="" tags="" timeout="" env="" pass="" deviates=""
  shift 2
  case "$kind" in box | host) ;; *) echo "ci_step: kind must be box or host, got '$kind'" >&2; exit 2 ;; esac
  while [[ $# -gt 0 && "$1" == --* ]]; do
    case "$1" in
      --job) job=$2; shift 2 ;;
      --env) env+="$(env_set "$2")"$'\n'; shift 2 ;;
      --set) env+="$2"$'\n'; shift 2 ;;
      --pass) pass+="$2"$'\n'; shift 2 ;;
      --timeout) timeout=$2; shift 2 ;;
      --deviates) [[ -n "${2:-}" ]] || { echo "ci_step '$name': --deviates needs a reason" >&2; exit 2; }; deviates=$2; shift 2 ;;
      --tag) tags+=",$2"; shift 2 ;;
      --) shift; break ;;
      *) echo "ci_step '$name': unknown option $1" >&2; exit 2 ;;
    esac
  done
  [[ $# -ge 1 ]] || { echo "ci_step '$name': no command" >&2; exit 2; }
  local cmd=$1
  shift
  local raw_args=""
  if [[ $kind == host ]]; then
    declare -F "$cmd" >/dev/null || { echo "ci_step '$name': '$cmd' is not a function" >&2; exit 2; }
    local arg
    for arg in "$@"; do
      cmd+=" $(printf '%q' "$arg")"
      raw_args+="$arg"$'\037'
    done
  fi
  if [[ -n "$job" ]]; then
    local j
    IFS=',' read -r -a wanted <<<"$job"
    for j in "${wanted[@]}"; do
      [[ " ${CI_JOBS[*]} " == *" $j "* ]] || { echo "ci_step '$name': unknown job '$j'" >&2; exit 2; }
    done
  fi
  PLAN_KINDS+=("$kind")
  PLAN_NAMES+=("$name")
  PLAN_JOBS+=("$job")
  PLAN_TAGS+=("${tags#,}")
  PLAN_TIMEOUTS+=("$timeout")
  PLAN_DEVIATES+=("$deviates")
  PLAN_ENVS+=("$env")
  PLAN_PASS+=("$pass")
  PLAN_ARGS+=("$raw_args")
  PLAN_CMDS+=("$cmd")
}

# True when JOB was selected with --only (or nothing was).
ci_selected() { [[ " ${SELECTED[*]} " == *" $1 "* ]]; }


# ------------------------------------------------------- engine host steps

base_image_tag() {
  echo "ci-local-base:${NODE_VERSION}-$(cksum <"$CI_LOCAL_HOME/docker/Dockerfile" | cut -d' ' -f1)"
}

runner_image_tag() {
  local sum
  if [[ -n "$CI_RUNNER_DOCKERFILE" ]]; then
    sum="$(cat "$CI_LOCAL_HOME/docker/Dockerfile" "$REPO/$CI_RUNNER_DOCKERFILE" | cksum | cut -d' ' -f1)"
    echo "$CI_PROJECT-runner:${NODE_VERSION}-$sum"
  else
    base_image_tag
  fi
}

# Host step: build the runner image when missing (or with --rebuild).
ci_build_runner() {
  local base runner
  base="$(base_image_tag)"
  runner="$(runner_image_tag)"
  if [[ $REBUILD -eq 0 ]] && docker image inspect "$runner" >/dev/null 2>&1; then
    echo "Runner image $runner is present."
    return 0
  fi
  if [[ $REBUILD -eq 1 ]] || ! docker image inspect "$base" >/dev/null 2>&1; then
    echo "Building $base (node:${NODE_VERSION}-bookworm, Docker client, sudo)"
    docker build --quiet --build-arg "NODE_VERSION=$NODE_VERSION" --tag "$base" \
      "$CI_LOCAL_HOME/docker" >/dev/null
  fi
  if [[ -n "$CI_RUNNER_DOCKERFILE" ]]; then
    echo "Building $runner from $CI_RUNNER_DOCKERFILE"
    docker build --quiet --build-arg "CI_LOCAL_BASE=$base" --tag "$runner" \
      --file "$REPO/$CI_RUNNER_DOCKERFILE" "$(dirname "$REPO/$CI_RUNNER_DOCKERFILE")" >/dev/null
  fi
}

# Host step: start the runner container on $CI_NETWORK.
ci_start_runner() {
  docker rm -f -v "$RUNNER" >/dev/null 2>&1 || true
  docker network inspect "$CI_NETWORK" >/dev/null 2>&1 ||
    docker network create --label "$CI_LABEL" "$CI_NETWORK" >/dev/null
  local args=(
    run --detach --init --name "$RUNNER" --network "$CI_NETWORK"
    --label "$CI_LABEL"
    # The checkout at its host path, so paths handed to the host's daemon (a
    # build context, a bind mount) mean the same there.
    --workdir "$REPO" --volume "$REPO:$REPO"
    # Never the host's node_modules, built for another system.
    --volume "$CI_PROJECT-node-modules:$REPO/node_modules"
    --volume "$CI_PROJECT-npm-cache:/home/runner/.npm"
    --volume "$CI_PROJECT-cache:/home/runner/.cache"
    --volume "$DOCKER_SOCK:/var/run/docker.sock"
    # What GitHub's runner sets.
    --env CI=true --env RUNNER_TEMP=/tmp
  )
  # The hosted runner checks out no ignored file: hide this checkout's.
  local file
  for file in ${CI_HIDE_FILES[@]+"${CI_HIDE_FILES[@]}"}; do
    [[ ! -f "$REPO/$file" ]] || args+=(--volume "$CI_LOCAL_HOME/docker/empty:$REPO/$file:ro")
  done
  args+=(${CI_RUNNER_ARGS[@]+"${CI_RUNNER_ARGS[@]}"})
  docker "${args[@]}" "$(runner_image_tag)" sleep infinity >/dev/null

  # An ordinary user, as on the hosted runner: the host user's uid and gid, so
  # files written in the checkout stay the developer's, in the group that owns
  # the Docker socket as the runner sees it, with sudo as on GitHub.
  local sock_gid
  sock_gid="$(docker exec "$RUNNER" stat -c %g /var/run/docker.sock)"
  docker exec --user root "$RUNNER" bash -euc '
    uid=$1; gid=$2; sock_gid=$3; repo=$4
    getent group "$gid" >/dev/null || groupadd -o -g "$gid" hostgroup
    getent group "$sock_gid" >/dev/null || groupadd -o -g "$sock_gid" hostdocker
    useradd -o -u "$uid" -g "$gid" -d /home/runner -s /bin/bash runner
    usermod -aG "$(getent group "$sock_gid" | cut -d: -f1)" runner
    # The cache volumes outlive runs; an earlier one may have written as another user.
    chown "$uid:$gid" /home/runner "$repo/node_modules"
    chown -R "$uid:$gid" /home/runner/.npm /home/runner/.cache
    # Docker also names ::1 localhost, and a server told to listen on localhost
    # may then listen on IPv6 alone while clients dial 127.0.0.1. On the hosted
    # runner localhost is 127.0.0.1 only. A bind mount: rewritten in place.
    hosts="$(awk '\''$1 == "::1" { line = $1; for (i = 2; i <= NF; i++) if ($i != "localhost") line = line " " $i; print line; next } { print }'\'' /etc/hosts)"
    printf "%s\n" "$hosts" > /etc/hosts
  ' _ "$(id -u)" "$(id -g)" "$sock_gid" "$REPO"
  docker exec --user runner "$RUNNER" sh -c 'echo "runner: $(id -un) (uid $(id -u)), node $(node -v), $(docker --version)"'
}

# Remove everything labelled for this project, the runner and the
# node_modules volume. Caches (npm, ~/.cache) and images stay.
teardown() {
  local ids
  # The runner first: while it is attached, a network it joined (one compose
  # created, say) cannot be removed by ci_teardown's `compose down`.
  docker rm -f -v "$RUNNER" >/dev/null 2>&1 || true
  [[ "$(type -t ci_teardown)" != function ]] || ci_teardown || true
  ids="$(docker ps -aq --filter "label=$CI_LABEL")"
  # shellcheck disable=SC2086
  [[ -z "$ids" ]] || docker rm -f -v $ids >/dev/null 2>&1 || true
  ids="$(docker network ls -q --filter "label=$CI_LABEL")"
  # shellcheck disable=SC2086
  [[ -z "$ids" ]] || docker network rm $ids >/dev/null 2>&1 || true
  ids="$(docker volume ls -q --filter "label=$CI_LABEL")"
  # shellcheck disable=SC2086
  [[ -z "$ids" ]] || docker volume rm -f $ids >/dev/null 2>&1 || true
  docker volume rm -f "$CI_PROJECT-node-modules" >/dev/null 2>&1 || true
}

# The containers compose started from this checkout under another project:
# the development stack. Name, id and start time, so a restart shows.
dev_snapshot() {
  local id
  while read -r id; do
    [[ -n "$id" ]] || continue
    docker inspect \
      --format '{{index .Config.Labels "com.docker.compose.project"}} {{.Name}} {{.Id}} {{.State.StartedAt}}' "$id"
  done < <(docker ps -aq --filter "label=com.docker.compose.project.working_dir=$REPO") |
    { grep -v "^$CI_PROJECT " || true; } | sort
}

# What the steps see of the checkout, which is not what GitHub checks out:
# the commit, the uncommitted changes, and the ignored files (a build output,
# a cache) a fresh checkout would not have. The root node_modules (a volume)
# and CI_HIDE_FILES are not seen, so not listed.
checkout_state() {
  if ! git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "checkout: not a git checkout"
    return 0
  fi
  local sha changes prefix path file hidden shown="" count=0
  sha="$(git -C "$REPO" rev-parse --short=12 HEAD 2>/dev/null)" || sha="(no commit yet)"
  changes="$(git -C "$REPO" status --porcelain --untracked-files=all -- . | grep -c . || true)"
  if [[ $changes -eq 0 ]]; then
    echo "checkout: commit $sha, clean"
  else
    echo "checkout: commit $sha, $changes uncommitted change(s)"
  fi
  prefix="$(git -C "$REPO" rev-parse --show-prefix)"
  while IFS= read -r path; do
    path="${path#!! }"
    path="${path#"$prefix"}"
    [[ "$path" != node_modules/ ]] || continue
    hidden=0
    for file in ${CI_HIDE_FILES[@]+"${CI_HIDE_FILES[@]}"}; do [[ "$path" != "$file" ]] || hidden=1; done
    [[ $hidden -eq 0 ]] || continue
    count=$((count + 1))
    [[ $count -gt 5 ]] || shown+=" $path"
  done < <(git -C "$REPO" status --porcelain --ignored --untracked-files=normal -- . | grep '^!! ' || true)
  [[ $count -le 5 ]] || shown+=" (and $((count - 5)) more)"
  [[ -z "$shown" ]] || echo "ignored files the steps can see:$shown"
}

# ---------------------------------------------------------------- output

fmt_duration() {
  local s=$1
  if [[ $s -ge 60 ]]; then printf '%dm%02ds' $((s / 60)) $((s % 60)); else printf '%ds' "$s"; fi
}

json_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

json_lines() {
  local first=1 line
  printf '['
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    first=0
    json_string "$line"
  done <<<"$1"
  printf ']'
}

json_array() {
  local first=1 item
  printf '['
  for item in "$@"; do
    [[ $first -eq 1 ]] || printf ','
    first=0
    json_string "$item"
  done
  printf ']'
}

# --events: EV_MS (epoch milliseconds) and EV_TS (ISO 8601, UTC) for now.
event_time() {
  local now
  if now="$(perl -MTime::HiRes=time -MPOSIX=strftime -e \
    '$t = time; printf "%d %s.%03dZ\n", $t * 1000, strftime("%Y-%m-%dT%H:%M:%S", gmtime($t)), ($t - int($t)) * 1000' 2>/dev/null)"; then
    EV_MS=${now%% *}
    EV_TS=${now#* }
  else
    EV_MS="$(date +%s)000"
    EV_TS="$(date -u +%Y-%m-%dT%H:%M:%S).000Z"
  fi
}

# emit_event SINCE_MS FIELDS: one line in the --events file. FIELDS is the
# JSON members after "ts"; with SINCE_MS, "durationMs" since then is added.
# Leaves the event's time in EV_MS, for the SINCE_MS of a later event; without
# --events it writes nothing and leaves EV_MS unset.
emit_event() {
  [[ -n "$EVENTS" ]] || return 0
  event_time
  local since=$1 fields=$2
  [[ -z "$since" ]] || fields+=",\"durationMs\":$((EV_MS - since))"
  # One write per line, so a reader never sees half of one.
  printf '{"ts":"%s",%s}\n' "$EV_TS" "$fields" >>"$EVENTS" || true
}

# --quiet: the log file of a step, NN-name.log.
step_log() {
  local slug
  slug="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')"
  slug="${slug#-}"
  slug="${slug%-}"
  printf '%s/%02d-%s.log' "$LOG_DIR" "$1" "${slug:0:60}"
}

# The plan as JSON, for parity checks: `@jals1212/ci-local/parity`.
print_plan() {
  local i fn
  printf '{"version":%s,"project":%s,"workflow":%s,"jobs":' \
    "$(json_string "$CI_LOCAL_VERSION")" "$(json_string "$CI_PROJECT")" "$(json_string "$CI_WORKFLOW")"
  json_array "${CI_JOBS[@]}"
  printf ',"runnerArgs":'
  json_array ${CI_RUNNER_ARGS[@]+"${CI_RUNNER_ARGS[@]}"}
  printf ',"notMirrored":['
  for i in ${NOT_MIRRORED_NAMES[@]+"${!NOT_MIRRORED_NAMES[@]}"}; do
    [[ $i -eq 0 ]] || printf ','
    printf '{"name":%s,"reason":%s}' "$(json_string "${NOT_MIRRORED_NAMES[$i]}")" "$(json_string "${NOT_MIRRORED_REASONS[$i]}")"
  done
  printf '],"steps":['
  for i in ${PLAN_NAMES[@]+"${!PLAN_NAMES[@]}"}; do
    [[ $i -eq 0 ]] || printf ','
    printf '{"kind":%s,"name":%s,"jobs":' "$(json_string "${PLAN_KINDS[$i]}")" "$(json_string "${PLAN_NAMES[$i]}")"
    json_lines "${PLAN_JOBS[$i]//,/$NL}"
    printf ',"tags":'
    json_lines "${PLAN_TAGS[$i]//,/$NL}"
    printf ',"timeout":%s,"deviates":' "${PLAN_TIMEOUTS[$i]:-null}"
    if [[ -n "${PLAN_DEVIATES[$i]}" ]]; then json_string "${PLAN_DEVIATES[$i]}"; else printf 'null'; fi
    printf ',"env":'
    json_lines "${PLAN_ENVS[$i]}"
    printf ',"pass":'
    json_lines "${PLAN_PASS[$i]}"
    printf ',"command":%s' "$(json_string "${PLAN_CMDS[$i]}")"
    if [[ "${PLAN_KINDS[$i]}" == host ]]; then
      fn="${PLAN_CMDS[$i]%% *}"
      printf ',"args":'
      json_lines "${PLAN_ARGS[$i]//$'\037'/$NL}"
      printf ',"source":%s' "$(json_string "$(declare -f "$fn")")"
    fi
    printf '}'
  done
  # Every function the config defines, so a check can follow a host step
  # into the helpers it calls.
  printf '],"functions":{'
  for i in ${CONFIG_FUNCTIONS[@]+"${!CONFIG_FUNCTIONS[@]}"}; do
    [[ $i -eq 0 ]] || printf ','
    printf '%s:%s' "$(json_string "${CONFIG_FUNCTIONS[$i]}")" "$(json_string "$(declare -f "${CONFIG_FUNCTIONS[$i]}")")"
  done
  printf '}}\n'
}

usage() {
  cat <<USAGE
Usage: ci-local [options]

Runs the steps of ${CI_WORKFLOW:-the workflow} in a Linux runner container, on a
private network, as described in ci-local.config.sh. The development stack is
not touched, and that is checked at the end.

Options:
  --only JOBS     Run only these jobs, comma separated (${CI_JOBS[*]:-see the config}).
  --skip TAGS     Leave out the steps with these tags, comma separated.
  --keep          Leave the runner and the services up afterwards
                  (docker exec -it ${CI_PROJECT:-<project>}-runner bash). --down removes them.
  --down          Remove what --keep left, and exit.
  --rebuild       Rebuild the runner image even if it exists.
  --quiet         Write each step's output to a log file instead of the
                  terminal; print only the step milestones, the end of a
                  failing step's log, and the summary. Or CI_LOCAL_QUIET=1.
  --events FILE   Append one JSON line per milestone (queued, run, step
                  start, ok, fail, end) to FILE, emptied when the run takes
                  it (a file a live run still writes waits for that run's
                  end): tail -f it from another terminal.
                  Or CI_LOCAL_EVENTS=FILE. Without it a run writes
                  them to ~/.cache/ci-local/<project>.ndjson (under
                  XDG_CACHE_HOME when set); CI_LOCAL_EVENTS=off writes none.
                  --list, --print-plan and --down ignore both.
  --no-wait       Do not wait for another ci-local run to finish: when the
                  machine is busy, say which run holds it and exit with
                  status 3. Runs of every project on this machine take turns,
                  first come first served, so Docker has one at a time.
                  CI_LOCAL_QUEUE=off lets runs overlap; the queue lives in
                  CI_LOCAL_QUEUE_DIR (default ~/.cache/ci-local/queue).
                  --list, --print-plan, --down and --status do not queue.
  --status        Print the state of the last run (queued, starting, running,
                  passed, failed, stopped) as a short Markdown block, from
                  its events file (the default one, or --events FILE), and
                  exit: 0 passed, 1 failed, 2 no run recorded, 3 queued,
                  starting or running, 4 stopped.
  --list          Print the steps that would run, and exit.
  --print-plan    Print the whole plan as JSON (for parity checks), and exit.
  --version       Print the version, and exit.
  -h, --help      This text.

Exit status: 0 when every step passed, 1 on the first failing step (named in
the summary), 2 on a usage or configuration error, 3 busy with --no-wait,
130 or 143 when interrupted. Environment variables and files: see README.
USAGE
}

# ---------------------------------------------------------------- options

ONLY=""
SKIP=""
KEEP=0
DOWN_ONLY=0
REBUILD=0
LIST_ONLY=0
PRINT_PLAN=0
HELP=0
STATUS=0
NO_WAIT=0
QUIET=0
case "${CI_LOCAL_QUIET:-}" in '' | 0 | false) ;; *) QUIET=1 ;; esac
# The queue every real run takes its turn in; CI_LOCAL_QUEUE=off lets runs overlap.
QUEUE=1
case "${CI_LOCAL_QUEUE:-}" in 0 | off | false | no) QUEUE=0 ;; esac
QUEUE_POLL="${CI_LOCAL_QUEUE_POLL:-2}" # seconds between two looks at the queue
# A number above 0: with 0 the wait would be a busy loop.
[[ "$QUEUE_POLL" =~ ^[0-9]+(\.[0-9]+)?$ && ! "$QUEUE_POLL" =~ ^0*(\.0*)?$ ]] || QUEUE_POLL=2
EVENTS="${CI_LOCAL_EVENTS:-}"
# Without --events a run writes to the default file (see DEFAULT_EVENTS);
# CI_LOCAL_EVENTS=off writes none.
EVENTS_OFF=0
case "$EVENTS" in 0 | off | false | no) EVENTS=""; EVENTS_OFF=1 ;; esac
# The command line as given, for the run event (and --status).
ORIG_ARGS=("$@")
# --quiet and --events given on this command line (not from the environment,
# a standing preference): an option that runs no step says it ignores them.
RUN_OPTIONS_GIVEN=""

# ignored_with MODE: the warning, on stderr so --print-plan's JSON stays clean.
ignored_with() {
  local option
  for option in $RUN_OPTIONS_GIVEN; do
    echo "ci-local: $option is ignored with $1: it runs no step" >&2
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --only) [[ $# -ge 2 && -n "$2" ]] || die_usage "--only needs a value"; ONLY=$2; shift 2 ;;
    --only=*) ONLY=${1#--only=}; [[ -n "$ONLY" ]] || die_usage "--only needs a value"; shift ;;
    --skip) [[ $# -ge 2 && -n "$2" ]] || die_usage "--skip needs a value"; SKIP=$2; shift 2 ;;
    --skip=*) SKIP=${1#--skip=}; [[ -n "$SKIP" ]] || die_usage "--skip needs a value"; shift ;;
    --keep) KEEP=1; shift ;;
    --down) DOWN_ONLY=1; shift ;;
    --rebuild) REBUILD=1; shift ;;
    --list) LIST_ONLY=1; shift ;;
    --print-plan) PRINT_PLAN=1; shift ;;
    --quiet) QUIET=1; RUN_OPTIONS_GIVEN+=" --quiet"; shift ;;
    --events) [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die_usage "--events needs a file name"; EVENTS=$2; EVENTS_OFF=0; RUN_OPTIONS_GIVEN+=" --events"; shift 2 ;;
    --events=*) EVENTS=${1#--events=}; [[ -n "$EVENTS" ]] || die_usage "--events needs a file name"; EVENTS_OFF=0; RUN_OPTIONS_GIVEN+=" --events"; shift ;;
    --no-wait) NO_WAIT=1; shift ;;
    --status) STATUS=1; shift ;;
    --version) echo "ci-local $CI_LOCAL_VERSION"; exit 0 ;;
    -h | --help) HELP=1; shift ;;
    *) die_usage "unknown option: $1" ;;
  esac
done

# A relative --events path is the caller's, not the repository root's.
[[ -z "$EVENTS" || "$EVENTS" == /* ]] || EVENTS="$(pwd -P)/$EVENTS"

# --status FILE: the last run's state, rendered from its events by status.js.
show_status() {
  command -v node >/dev/null || { echo "ci-local: --status needs node" >&2; exit 2; }
  exec node "$CI_LOCAL_HOME/status.js" "$1"
}

if [[ $STATUS -eq 1 && $HELP -eq 0 ]]; then
  [[ -z "$ONLY$SKIP" && $KEEP$DOWN_ONLY$REBUILD$LIST_ONLY$PRINT_PLAN$NO_WAIT == 000000 && "$RUN_OPTIONS_GIVEN" != *--quiet* ]] ||
    die_usage "--status takes only --events"
  # An events file named on the command line or in the environment needs no
  # config: --status reads it from anywhere.
  [[ -z "$EVENTS" ]] || show_status "$EVENTS"
fi

REPO="$(find_repo)" || {
  [[ $HELP -eq 0 ]] || { usage; exit 0; }
  echo "ci-local: no ${CI_LOCAL_CONFIG:-ci-local.config.sh} here or in a parent directory" >&2
  exit 2
}
cd "$REPO"

# The functions the config defines, for --print-plan: the engine's are known
# before it is sourced.
FUNCTIONS_BEFORE="$NL$(declare -F)$NL"
# shellcheck disable=SC1090
source "$REPO/${CI_LOCAL_CONFIG:-ci-local.config.sh}"
CONFIG_FUNCTIONS=()
while read -r _ _ fn; do
  [[ "$FUNCTIONS_BEFORE" == *" $fn$NL"* ]] || CONFIG_FUNCTIONS+=("$fn")
done < <(declare -F)

[[ $HELP -eq 0 ]] || { usage; exit 0; }

[[ "$CI_PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]] ||
  { echo "ci-local: CI_PROJECT must be a lowercase name, got '$CI_PROJECT'" >&2; exit 2; }
# The user's own cache: XDG_CACHE_HOME, else ~/.cache, else (neither set, as
# under a bare service) a directory of this user's under TMPDIR.
CACHE_BASE=""
CACHE_BASE_PRIVATE=0
if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  CACHE_BASE=$XDG_CACHE_HOME
elif [[ -n "${HOME:-}" ]]; then
  CACHE_BASE="$HOME/.cache"
else
  CACHE_BASE="${TMPDIR:-/tmp}"
  CACHE_BASE="${CACHE_BASE%/}/ci-local-$(id -u)"
  CACHE_BASE_PRIVATE=1
fi
CI_CACHE_DIR="$CACHE_BASE/ci-local"
# Where a run writes its events without --events, and --status reads them:
# outside the checkout, in the user's own cache.
DEFAULT_EVENTS="$CI_CACHE_DIR/$CI_PROJECT.ndjson"

# True for a real directory (no symlink) of this user that no one else can
# write.
private_dir() {
  local mode
  [[ -d "$1" && ! -L "$1" && -O "$1" ]] || return 1
  mode="$(ls -ld "$1" 2>/dev/null)" || return 1
  [[ "${mode:5:1}" != w && "${mode:8:1}" != w ]]
}
# The TMPDIR fallback is a fixed name in a shared directory: one that is
# there already and is not ours alone (planted, or a symlink to elsewhere) is
# never used, for events or for the queue. One planted after this check is
# caught by make_cache_dir, which in the fallback checks both directories
# again once they exist, before anything is written in them.
if [[ $CACHE_BASE_PRIVATE -eq 1 ]] && { [[ -L "$CACHE_BASE" ]] || { [[ -e "$CACHE_BASE" ]] && ! private_dir "$CACHE_BASE"; }; }; then
  echo "ci-local: $CACHE_BASE is not a private directory of this user: no events file, no queue" >&2
  [[ $STATUS -eq 0 ]] || exit 2
  EVENTS_OFF=1
  QUEUE=0
fi

# Makes ci-local's directory in the cache, readable by its user alone (the
# directories above it, when they are the TMPDIR fallback's, too).
make_cache_dir() {
  if [[ ! -d "$CI_CACHE_DIR" ]]; then
    if [[ $CACHE_BASE_PRIVATE -eq 1 && ! -d "$CACHE_BASE" ]]; then
      mkdir -p "$CACHE_BASE" && chmod 700 "$CACHE_BASE" || return 1
    fi
    mkdir -p "$CI_CACHE_DIR" && chmod 700 "$CI_CACHE_DIR" || return 1
  fi
  # In the shared TMPDIR: whatever exists now must be ours alone.
  [[ $CACHE_BASE_PRIVATE -eq 0 ]] || { private_dir "$CACHE_BASE" && private_dir "$CI_CACHE_DIR"; }
}
if [[ $STATUS -eq 1 ]]; then
  # Off in the environment, runs write no events: the default file, if any,
  # is an old run's, not the last one's.
  [[ $EVENTS_OFF -eq 0 ]] ||
    { echo "ci-local: CI_LOCAL_EVENTS is off: runs record no events, so --status has none to show" >&2; exit 2; }
  show_status "$DEFAULT_EVENTS"
fi
[[ ${#CI_JOBS[@]} -gt 0 ]] || { echo "ci-local: CI_JOBS is empty" >&2; exit 2; }
[[ "$(type -t ci_plan)" == function ]] || { echo "ci-local: the config defines no ci_plan function" >&2; exit 2; }
CI_NETWORK="${CI_NETWORK:-$CI_PROJECT}"
# Put on whatever a host step creates (`docker run --label "$CI_LABEL"`), so
# the cleanup finds and removes it.
CI_LABEL="ci-local.project=$CI_PROJECT"
RUNNER="$CI_PROJECT-runner"
DOCKER_SOCK="${CI_LOCAL_DOCKER_SOCK:-/var/run/docker.sock}"

[[ -f "$REPO/.nvmrc" ]] || { echo "ci-local: no .nvmrc in $REPO" >&2; exit 2; }
NODE_VERSION="$(tr -d '[:space:]' <"$REPO/.nvmrc")"
NODE_VERSION="${NODE_VERSION#v}"
[[ "$NODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  { echo "ci-local: .nvmrc must name an exact version such as 24.16.0 (got '$NODE_VERSION')" >&2; exit 2; }

SELECTED=("${CI_JOBS[@]}")
if [[ -n "$ONLY" ]]; then
  [[ "$ONLY" =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ ]] || die_usage "--only takes job names separated by commas, got '$ONLY'"
  IFS=',' read -r -a requested <<<"$ONLY"
  for name in "${requested[@]}"; do
    [[ " ${CI_JOBS[*]} " == *" $name "* ]] || die_usage "unknown job '$name' (one of: ${CI_JOBS[*]})"
  done
  # Always the config's order, whatever order was asked for.
  SELECTED=()
  for job in "${CI_JOBS[@]}"; do
    [[ ",$ONLY," != *",$job,"* ]] || SELECTED+=("$job")
  done
fi

ci_plan

# The steps that run: those of a selected job, without a skipped tag.
RUN_INDEXES=()
for i in ${PLAN_NAMES[@]+"${!PLAN_NAMES[@]}"}; do
  keep=1
  if [[ -n "${PLAN_JOBS[$i]}" ]]; then
    keep=0
    IFS=',' read -r -a step_jobs <<<"${PLAN_JOBS[$i]}"
    for job in "${step_jobs[@]}"; do ci_selected "$job" && keep=1; done
  fi
  if [[ $keep -eq 1 && -n "$SKIP" && -n "${PLAN_TAGS[$i]}" ]]; then
    IFS=',' read -r -a step_tags <<<"${PLAN_TAGS[$i]}"
    for tag in "${step_tags[@]}"; do [[ ",$SKIP," != *",$tag,"* ]] || keep=0; done
  fi
  [[ $keep -eq 0 ]] || RUN_INDEXES+=("$i")
done

if [[ $PRINT_PLAN -eq 1 ]]; then ignored_with --print-plan; print_plan; exit 0; fi

if [[ $LIST_ONLY -eq 1 ]]; then
  ignored_with --list
  n=0
  for i in ${RUN_INDEXES[@]+"${RUN_INDEXES[@]}"}; do
    n=$((n + 1))
    printf '%2d. [%s] %s\n' "$n" "${PLAN_KINDS[$i]}" "${PLAN_NAMES[$i]}"
  done
  exit 0
fi

command -v docker >/dev/null || { echo "ci-local: docker is not installed" >&2; exit 2; }
docker version --format '{{.Server.Version}}' >/dev/null 2>&1 ||
  { echo "ci-local: the docker daemon is not reachable" >&2; exit 2; }

if [[ $DOWN_ONLY -eq 1 ]]; then
  ignored_with --down
  teardown
  echo "Removed what project $CI_PROJECT left."
  exit 0
fi

[[ "$(type -t ci_preflight)" != function ]] || ci_preflight

# -------------------------------------------------------------------- run

RESULTS=()
DURATIONS=()
FAILED_STEP=""
SUMMARY_PRINTED=0
PLAN_STARTED=0
STARTED=$SECONDS # reset when the run's turn comes: the total does not count the wait
DEV_BEFORE=""
CHECKOUT=""
LOG_DIR=""
RUN_MS=""
CURRENT_STEP="" # the name of the step running, for an interrupt
CURRENT_LOG=""
CURRENT_MS=""
CURRENT_FIELDS=""

print_summary() {
  local i n=0 line
  SUMMARY_PRINTED=1
  echo
  echo "ci-local summary: node ${NODE_VERSION}, project ${CI_PROJECT}, jobs: ${SELECTED[*]}${SKIP:+, skipped tags: $SKIP}"
  for i in ${RUN_INDEXES[@]+"${RUN_INDEXES[@]}"}; do
    printf '  %-8s %-58s %s\n' "${RESULTS[$n]:-not run}" "${PLAN_NAMES[$i]}" "${DURATIONS[$n]:-}"
    n=$((n + 1))
  done
  echo "  total $(fmt_duration $((SECONDS - STARTED)))"
  while IFS= read -r line; do echo "  $line"; done <<<"$CHECKOUT"
  # A step that ran another command than its workflow step on purpose makes
  # this run weaker than GitHub's: say where, and why, every time.
  n=0
  for i in ${RUN_INDEXES[@]+"${RUN_INDEXES[@]}"}; do
    if [[ -n "${RESULTS[$n]:-}" && -n "${PLAN_DEVIATES[$i]}" ]]; then
      echo "  DEVIATES ${PLAN_NAMES[$i]}: ${PLAN_DEVIATES[$i]}"
    fi
    n=$((n + 1))
  done
  if [[ -n "$FAILED_STEP" ]]; then
    echo "FAILED at step: $FAILED_STEP"
  else
    echo "PASSED: every step ran and passed. This is not the GitHub check."
  fi
}

run_step() {
  local i=$1 line
  if [[ "${PLAN_KINDS[$i]}" == host ]]; then
    # A subshell outside any `||`, so `set -e` holds inside the function.
    (
      set -e
      eval "${PLAN_CMDS[$i]}"
    ) 3>&- 4>&- &
    wait $!
    return
  fi
  local args=(exec --user runner --workdir "$REPO")
  while IFS= read -r line; do [[ -z "$line" ]] || args+=(--env "$line"); done <<<"${PLAN_ENVS[$i]}"
  while IFS= read -r line; do [[ -z "$line" ]] || args+=(--env "$line"); done <<<"${PLAN_PASS[$i]}"
  args+=("$RUNNER")
  [[ -z "${PLAN_TIMEOUTS[$i]}" ]] || args+=(timeout --kill-after=30 "${PLAN_TIMEOUTS[$i]}")
  # In the background and waited for, so an interrupt is handled at once and
  # the cleanup removes the runner, which ends the step. Without the
  # terminal's saved descriptors (3, 4): a step must not hold them open.
  docker "${args[@]}" bash -eo pipefail -c "${PLAN_CMDS[$i]}" 3>&- 4>&- &
  wait $!
}

run_plan() {
  local total=${#RUN_INDEXES[@]} n=0 i began elapsed code
  for i in ${RUN_INDEXES[@]+"${RUN_INDEXES[@]}"}; do
    echo
    echo "==> [$((n + 1))/$total] ${PLAN_NAMES[$i]}"
    began=$SECONDS
    CURRENT_STEP="${PLAN_NAMES[$i]}"
    CURRENT_FIELDS="\"step\":$(json_string "${PLAN_NAMES[$i]}"),\"index\":$((n + 1)),\"total\":$total"
    if [[ $QUIET -eq 1 ]]; then
      CURRENT_LOG="$(step_log $((n + 1)) "${PLAN_NAMES[$i]}")"
      CURRENT_FIELDS+=",\"log\":$(json_string "$CURRENT_LOG")"
    fi
    emit_event "" "\"event\":\"start\",$CURRENT_FIELDS"
    CURRENT_MS=${EV_MS:-} # the start event's time: the step's durationMs counts from it
    set +e
    if [[ $QUIET -eq 1 ]]; then
      run_step "$i" >"$CURRENT_LOG" 2>&1
    else
      run_step "$i"
    fi
    code=$?
    set -e
    CURRENT_STEP=""
    elapsed=$((SECONDS - began))
    DURATIONS[n]="$(fmt_duration "$elapsed")"
    if [[ $code -eq 0 ]]; then
      RESULTS[n]="ok"
      emit_event "$CURRENT_MS" "\"event\":\"ok\",$CURRENT_FIELDS"
      echo "<== ${PLAN_NAMES[$i]}: ok ($(fmt_duration "$elapsed"))"
    else
      RESULTS[n]="FAILED"
      FAILED_STEP="${PLAN_NAMES[$i]}"
      emit_event "$CURRENT_MS" "\"event\":\"fail\",$CURRENT_FIELDS,\"exitCode\":$code"
      if [[ -n "${PLAN_TIMEOUTS[$i]}" && ($code -eq 124 || $code -eq 137) ]]; then
        echo "<== ${PLAN_NAMES[$i]}: TIMED OUT after $(fmt_duration "${PLAN_TIMEOUTS[$i]}")" >&2
      else
        echo "<== ${PLAN_NAMES[$i]}: FAILED with exit code $code ($(fmt_duration "$elapsed"))" >&2
      fi
      if [[ $QUIET -eq 1 ]]; then
        echo "Last 40 lines of $CURRENT_LOG:" >&2
        tail -n 40 "$CURRENT_LOG" | sed 's/^/  /' >&2
      fi
      return 1
    fi
    n=$((n + 1))
  done
}

# ------------------------------------------------------------------ queue
#
# One run at a time on the machine, whatever the project: Docker (and the
# VM behind it on a Mac) does not take several of these at once. A run takes
# a ticket, named by the time it came, and goes ahead when its ticket is the
# first of a live process AND it wins the lock directory.
#
#   QUEUE_DIR/<epoch-ms>-<pid>   one ticket per run, with project=, pid=, repo=
#   QUEUE_DIR/lock/              made with mkdir (atomic) by the run in turn;
#                                lock/pid names it, lock/project says whose

QUEUE_DIR=""
MY_NAME=""
MY_TICKET=""
HAVE_LOCK=0
SLEEPER=""
AHEAD=0          # live tickets before ours
FIRST_TICKET=""  # the first of them
BLOCK_PROJECT="" # who we wait for ("" when nobody)
BLOCK_PID=""

# True when a process with this pid exists (ours or not: kill says EPERM for
# another user's, ps still lists it).
pid_alive() {
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$1" 2>/dev/null || ps -p "$1" >/dev/null 2>&1
}

# ticket_value FILE KEY: what follows `KEY=` in the file; nothing when absent.
ticket_value() {
  local line
  [[ -r "$1" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$2="* ]]; then
      printf '%s' "${line#"$2="}"
      return 0
    fi
  done 2>/dev/null <"$1" || true
}

file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || true; }

# The queue directory, made; false when it cannot be (or is not absolute).
queue_setup() {
  if [[ -n "${CI_LOCAL_QUEUE_DIR:-}" ]]; then
    QUEUE_DIR=$CI_LOCAL_QUEUE_DIR
  else
    QUEUE_DIR="$CI_CACHE_DIR/queue"
    make_cache_dir 2>/dev/null || return 1
    [[ -d "$QUEUE_DIR" ]] || { mkdir "$QUEUE_DIR" 2>/dev/null && chmod 700 "$QUEUE_DIR"; } || return 1
  fi
  [[ "$QUEUE_DIR" == /* ]] && mkdir -p "$QUEUE_DIR" 2>/dev/null && [[ -w "$QUEUE_DIR" ]]
}

# Our ticket, complete or absent: written aside, then moved into place.
write_ticket() {
  local tmp="$QUEUE_DIR/.ticket.$$"
  printf 'project=%s\npid=%s\nrepo=%s\n' "$CI_PROJECT" "$$" "$REPO" >"$tmp" && mv "$tmp" "$MY_TICKET"
}

# Counts the live tickets before ours into AHEAD (FIRST_TICKET is the first)
# and removes those of dead processes. False when ours is not there.
queue_scan() {
  local f name pid
  AHEAD=0
  FIRST_TICKET=""
  for f in "$QUEUE_DIR"/[0-9]*-[0-9]*; do
    [[ -f "$f" ]] || continue
    name=${f##*/}
    [[ "$name" =~ ^[0-9]{15}-[0-9]{10}$ ]] || continue
    [[ "$name" != "$MY_NAME" ]] || return 0
    pid=$((10#${name##*-}))
    if pid_alive "$pid"; then
      AHEAD=$((AHEAD + 1))
      [[ -n "$FIRST_TICKET" ]] || FIRST_TICKET=$f
    else
      rm -f "$f"
    fi
  done
  return 1
}

# Takes the lock when it is free or its holder is gone; else false, with
# BLOCK_PROJECT and BLOCK_PID naming the holder. A live holder's lock is
# never removed. A lock with no pid yet is a run between mkdir and its
# write: held, until it is older than 10 seconds.
queue_lock() {
  local lock="$QUEUE_DIR/lock" holder mtime
  for _ in 1 2; do
    if mkdir "$lock" 2>/dev/null; then
      HAVE_LOCK=1
      printf '%s' "$CI_PROJECT" >"$lock/project"
      printf '%s\n' "$$" >"$lock/pid"
      return 0
    fi
    BLOCK_PROJECT="$(cat "$lock/project" 2>/dev/null || true)"
    # Released between the mkdir and this read: free again, try again.
    [[ -n "$BLOCK_PROJECT" || -d "$lock" ]] || continue
    [[ -n "$BLOCK_PROJECT" ]] || BLOCK_PROJECT=unknown
    holder=""
    [[ ! -f "$lock/pid" ]] || read -r holder <"$lock/pid" 2>/dev/null || true
    if [[ "$holder" =~ ^[0-9]+$ ]]; then
      holder=$((10#$holder))
      if pid_alive "$holder"; then
        BLOCK_PID=$holder
        return 1
      fi
    else
      BLOCK_PID=""
      mtime="$(file_mtime "$lock")"
      [[ "$mtime" =~ ^[0-9]+$ && $(($(date +%s) - mtime)) -gt 10 ]] || return 1
    fi
    # Stale: moved away whole (a half-removed lock must not be seen), then removed.
    mv "$lock" "$QUEUE_DIR/.stale.$$" 2>/dev/null && rm -rf "$QUEUE_DIR/.stale.$$"
  done
  return 1
}

# One look at the queue: true with the lock taken. Otherwise AHEAD,
# BLOCK_PROJECT and BLOCK_PID say what we wait for: the first live ticket
# before ours, else the holder of the lock.
queue_poll() {
  local name tries
  for tries in 1 2 3; do
    BLOCK_PROJECT=""
    BLOCK_PID=""
    # Our ticket gone (removed by mistake, or never made): made again, looked for again.
    if ! queue_scan; then
      write_ticket
      queue_scan || true
    fi
    if [[ $AHEAD -gt 0 ]]; then
      name=${FIRST_TICKET##*/}
      BLOCK_PID=$((10#${name##*-}))
      BLOCK_PROJECT="$(ticket_value "$FIRST_TICKET" project)"
      # That run ended between the scan and this read: look again rather than
      # report an unknown project (or a change that is none).
      [[ -n "$BLOCK_PROJECT" || -e "$FIRST_TICKET" || $tries -eq 3 ]] || continue
      [[ -n "$BLOCK_PROJECT" ]] || BLOCK_PROJECT=unknown
      return 1
    fi
    queue_lock || return 1
    BLOCK_PROJECT=""
    BLOCK_PID=""
    return 0
  done
}

# The lock (when ours: lock/pid is this process) and the ticket, given back.
queue_release() {
  local lock="$QUEUE_DIR/lock" holder=""
  if [[ $HAVE_LOCK -eq 1 ]]; then
    read -r holder <"$lock/pid" 2>/dev/null || true
    if [[ "$holder" == "$$" ]]; then
      mv "$lock" "$QUEUE_DIR/.released.$$" 2>/dev/null && rm -rf "$QUEUE_DIR/.released.$$"
    fi
    HAVE_LOCK=0
  fi
  [[ -z "$MY_TICKET" ]] || rm -f "$MY_TICKET"
  MY_TICKET=""
}

# The exit of a run that never had its turn (an interrupt, --no-wait): its
# ticket goes, and nothing else: no teardown, for another run of this project
# may hold the lock and its runner is that run's.
queue_leave() {
  local status=$?
  trap - EXIT INT TERM
  set +e
  [[ -z "$SLEEPER" ]] || kill "$SLEEPER" 2>/dev/null
  queue_release
  [[ -z "$LOG_DIR" ]] || rmdir "$LOG_DIR" 2>/dev/null
  exit "$status"
}

# The queued event: where we stand in the queue, now.
emit_queued() {
  local by=null
  [[ -z "$BLOCK_PROJECT" ]] ||
    by="{\"project\":$(json_string "$BLOCK_PROJECT"),\"pid\":${BLOCK_PID:-null}}"
  emit_event "" "\"event\":\"queued\",\"project\":$(json_string "$CI_PROJECT"),\"version\":$(json_string "$CI_LOCAL_VERSION"),\"pid\":$$,\"commit\":$RUN_COMMIT,\"args\":$(json_array ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}),\"logDir\":$RUN_LOG_DIR,\"ahead\":$AHEAD,\"blockedBy\":$by"
}

# Waits for the turn, and takes the lock. Prints what it waits for when that
# changes; with --no-wait, a busy machine is status 3.
queue_wait() {
  local key last="" began=$SECONDS waited=0 got
  AHEAD=0
  BLOCK_PROJECT=""
  BLOCK_PID=""
  if [[ $QUEUE -eq 1 ]] && ! queue_setup; then
    echo "ci-local: cannot use the queue directory $QUEUE_DIR: running without waiting" >&2
    QUEUE=0
  fi
  if [[ $QUEUE -eq 0 ]]; then
    emit_position
    return 0
  fi
  event_time
  MY_NAME="$(printf '%015d-%010d' "${EV_MS:-0}" "$$")"
  MY_TICKET="$QUEUE_DIR/$MY_NAME"
  write_ticket
  trap queue_leave EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  while :; do
    got=0
    queue_poll && got=1
    key="$AHEAD|$BLOCK_PROJECT|$BLOCK_PID"
    if [[ "$key" != "$last" ]]; then
      last=$key
      # Refused before anything is recorded: the events file keeps the
      # project's last run for --status.
      if [[ $got -eq 0 && $NO_WAIT -eq 1 ]]; then
        echo "ci-local: the machine is busy: $BLOCK_PROJECT (pid ${BLOCK_PID:-?})" >&2
        exit 3
      fi
      emit_position
      if [[ $got -eq 0 ]]; then
        echo "Waiting for $BLOCK_PROJECT (pid ${BLOCK_PID:-?}) · $AHEAD ahead"
        waited=1
      fi
    fi
    [[ $got -eq 0 ]] || break
    # In the background and waited for: a signal is handled at once.
    sleep "$QUEUE_POLL" &
    SLEEPER=$!
    wait "$SLEEPER" || true
    SLEEPER=""
  done
  [[ $waited -eq 0 ]] || echo "Queue: your turn after $(fmt_duration $((SECONDS - began)))"
  return 0
}

finish() {
  local status=$?
  trap - EXIT INT TERM
  set +e
  # An interrupt in a --quiet step lands here with its output still going
  # to the step's log: back to the terminal.
  exec 1>&3 2>&4
  if [[ $PLAN_STARTED -eq 1 && $SUMMARY_PRINTED -eq 0 ]]; then
    FAILED_STEP="${FAILED_STEP:-interrupted}"
    if [[ -n "$CURRENT_STEP" ]]; then
      emit_event "$CURRENT_MS" "\"event\":\"fail\",$CURRENT_FIELDS,\"exitCode\":$status"
      [[ $QUIET -eq 0 ]] || echo "Output of the interrupted step: $CURRENT_LOG" >&2
    fi
    print_summary
    [[ $status -ne 0 ]] || status=1
  fi
  if [[ -n "$FAILED_STEP" ]]; then
    echo
    echo "Containers of project $CI_PROJECT at the failure:"
    docker ps -a --filter "label=$CI_LABEL" --format '  {{.Names}}  {{.Status}}'
    # The project's own diagnostics (service logs, a compose ps), before the cleanup.
    [[ "$(type -t ci_on_failure)" != function ]] || ci_on_failure "$FAILED_STEP" || true
  fi
  echo
  if [[ $KEEP -eq 1 ]]; then
    echo "Kept: project $CI_PROJECT is still up. Remove it with: ci-local --down"
  else
    echo "Removing project $CI_PROJECT (runner, services, network, node_modules volume)"
    teardown
  fi
  local dev_stack=none
  if [[ -n "$DEV_BEFORE" ]]; then
    local after
    after="$(dev_snapshot)"
    if [[ "$after" == "$DEV_BEFORE" ]]; then
      dev_stack=untouched
      echo "Development stack untouched: $(grep -c . <<<"$DEV_BEFORE") container(s), same ids and start times as before."
    else
      dev_stack=changed
      echo "WARNING: the development stack changed during this run:" >&2
      diff <(echo "$DEV_BEFORE") <(echo "$after") >&2
      [[ $status -ne 0 ]] || status=1
    fi
  fi
  if [[ $PLAN_STARTED -eq 1 ]]; then
    local result
    if [[ "$FAILED_STEP" == interrupted ]]; then
      result=interrupted
    elif [[ $status -eq 0 ]]; then
      result=passed
    else
      result=failed # a failing step, or a development stack that changed
    fi
    emit_event "$RUN_MS" "\"event\":\"end\",\"result\":\"$result\",\"devStack\":\"$dev_stack\""
  fi
  # Last: the next run's turn comes when the teardown and the end event are done.
  queue_release
  exit "$status"
}

# The pid of another run, still going, whose events FILE holds (its first
# event names it and no end event closed it); nothing otherwise.
events_owner() {
  local first pid
  [[ -s "$1" ]] || return 0
  ! grep -q '"event":"end"' "$1" 2>/dev/null || return 0
  IFS= read -r first <"$1" 2>/dev/null || return 0
  [[ "$first" =~ \"pid\":([0-9]+) ]] || return 0
  pid=${BASH_REMATCH[1]}
  if [[ "$pid" != "$$" ]] && pid_alive "$pid"; then echo "$pid"; fi
  return 0
}

# Checked writable first, without emptying it: another run of this project
# may still be writing it.
if [[ -n "$EVENTS" ]]; then
  : 2>/dev/null >>"$EVENTS" || { echo "ci-local: cannot write the --events file $EVENTS" >&2; exit 2; }
elif [[ $EVENTS_OFF -eq 0 ]]; then
  # The default file is a convenience for --status: never a reason to stop.
  if make_cache_dir 2>/dev/null && : 2>/dev/null >>"$DEFAULT_EVENTS"; then
    EVENTS=$DEFAULT_EVENTS
  else
    echo "ci-local: cannot write the events file $DEFAULT_EVENTS: --status will not see this run" >&2
  fi
fi
# The step logs: made only once nothing above can stop the run.
if [[ $QUIET -eq 1 ]]; then
  tmp="${TMPDIR:-/tmp}"
  LOG_DIR="$(mktemp -d "${tmp%/}/$CI_PROJECT-logs.XXXXXX")"
fi

# The commit the steps see; null outside a git checkout.
RUN_COMMIT=null
if git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  RUN_COMMIT="$(git -C "$REPO" rev-parse --short=12 HEAD 2>/dev/null)" && RUN_COMMIT="$(json_string "$RUN_COMMIT")" || RUN_COMMIT=null
fi
RUN_LOG_DIR=null
[[ -z "$LOG_DIR" ]] || RUN_LOG_DIR="$(json_string "$LOG_DIR")"

# claim_events FILE: takes FILE for this run when no live run owns it:
# empties it and writes the first queued event, all under FILE.claim (an
# atomic mkdir), so two runs starting together cannot both take it. False
# when a live run owns it (OWNER names it) or the claim cannot be had
# (OWNER empty). A claim older than 10 seconds is a dead run's: broken; one
# that cannot be removed is given up. Where no claim can be made at all (a
# directory the user cannot write, with a writable file in it), the file is
# taken without one, as before 0.4.0.
claim_events() {
  local claim="$1.claim" mtime tries=0 held=1
  OWNER=""
  until mkdir "$claim" 2>/dev/null; do
    if [[ ! -e "$claim" ]]; then
      # Released between the two looks, or it cannot be made at all.
      mkdir "$claim" 2>/dev/null && break
      if [[ ! -e "$claim" ]]; then
        held=0
        break
      fi
    fi
    mtime="$(file_mtime "$claim")"
    if [[ "$mtime" =~ ^[0-9]+$ && $(($(date +%s) - mtime)) -gt 10 ]]; then
      mv "$claim" "$claim.stale.$$" 2>/dev/null || return 1
      rm -rf "$claim.stale.$$"
      continue
    fi
    tries=$((tries + 1))
    [[ $tries -le 200 ]] || return 1
    sleep 0.05
  done
  OWNER="$(events_owner "$1")"
  if [[ -z "$OWNER" ]]; then
    : >"$1"
    EVENTS=$1
    emit_queued
  fi
  # Only a claim this run made: without one, another run's may be there now.
  [[ $held -eq 0 ]] || rmdir "$claim" 2>/dev/null
  [[ -z "$OWNER" ]]
}

# The file is claimed with the first queued event (emit_position), once the
# run knows its place. A file a live run still writes is left to it: this run
# takes it over at its turn (the queue lets the other run end first), and
# emits nothing before.
EVENTS_CLAIM=$EVENTS
EVENTS=""
EVENTS_LATER=""

# Where the run stands in the queue, in the events: the first time, by
# claiming the events file with it.
emit_position() {
  [[ -n "$EVENTS_CLAIM" ]] || { emit_queued; return 0; }
  local target=$EVENTS_CLAIM
  EVENTS_CLAIM=""
  claim_events "$target" && return 0
  if [[ -n "$OWNER" ]]; then
    EVENTS_LATER=$target
  else
    echo "ci-local: cannot claim the events file $target: this run writes no events" >&2
  fi
}

# Queued from here: --status shows the run at once, and until its turn comes
# nothing touches Docker.
queue_wait
if [[ -n "$EVENTS_LATER" ]] && ! claim_events "$EVENTS_LATER"; then
  if [[ -n "$OWNER" ]]; then
    # Only without the queue: both runs go on, and the file stays the other's.
    echo "ci-local: the events file $EVENTS_LATER belongs to run $OWNER, still going: this run writes no events" >&2
  else
    echo "ci-local: cannot claim the events file $EVENTS_LATER: this run writes no events" >&2
  fi
fi
STARTED=$SECONDS

# The terminal, for finish (see there).
exec 3>&1 4>&2
DEV_BEFORE="$(dev_snapshot)"
# Before any step writes to the checkout.
CHECKOUT="$(checkout_state)"
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "ci-local $CI_LOCAL_VERSION: ${#RUN_INDEXES[@]} steps, node ${NODE_VERSION}, project ${CI_PROJECT}, jobs: ${SELECTED[*]}"
[[ -z "$LOG_DIR" ]] || echo "Step output: $LOG_DIR"
if [[ "$EVENTS" == "$DEFAULT_EVENTS" ]]; then
  echo "Events: $EVENTS (ci-local --status)"
elif [[ -n "$EVENTS" ]]; then
  echo "Events: $EVENTS (ci-local --status --events $EVENTS)"
fi
if [[ -n "$DEV_BEFORE" ]]; then
  echo "Development stack, left alone:"
  while read -r line; do echo "  ${line:0:100}"; done <<<"$DEV_BEFORE"
fi
# A run left by --keep, or one that was killed: always start clean.
teardown
PLAN_STARTED=1
# RUN_MS: the run event's time, from which the end event's durationMs counts.
# pid: --status tells a run still going from one killed before its end event.
emit_event "" "\"event\":\"run\",\"project\":$(json_string "$CI_PROJECT"),\"jobs\":$(json_array "${SELECTED[@]}"),\"total\":${#RUN_INDEXES[@]},\"version\":$(json_string "$CI_LOCAL_VERSION"),\"pid\":$$,\"commit\":$RUN_COMMIT,\"args\":$(json_array ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}),\"logDir\":$RUN_LOG_DIR"
RUN_MS=${EV_MS:-}
# Not `run_plan || true`: bash ignores `set -e` in everything under a `||`,
# subshells included, and host steps rely on it.
set +e
run_plan
set -e
print_summary
[[ -z "$FAILED_STEP" ]]
