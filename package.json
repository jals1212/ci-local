{
  "name": "@jals1212/ci-local",
  "version": "0.6.0",
  "description": "Run a Node project's GitHub Actions workflow steps on your machine, in Linux, without touching your development stack, with parity checks that keep the two in step.",
  "license": "MIT",
  "author": "jals1212",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jals1212/ci-local.git"
  },
  "homepage": "https://github.com/jals1212/ci-local#readme",
  "bugs": "https://github.com/jals1212/ci-local/issues",
  "keywords": ["ci", "github-actions", "docker", "local", "workflow", "parity", "pi-package"],
  "type": "module",
  "bin": {
    "ci-local": "bin/ci-local"
  },
  "exports": {
    "./status": {
      "types": "./status.d.ts",
      "default": "./status.js"
    },
    "./parity": {
      "types": "./parity.d.ts",
      "default": "./parity.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["bin", "docker", "pi/bridge.ts", "pi/extensions", "pi/skills", "parity.js", "parity.d.ts", "status.js", "status.d.ts", "CHANGELOG.md"],
  "pi": {
    "extensions": ["./pi/bridge.ts"],
    "skills": ["./pi/skills"]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/link-self.mjs",
    "pretest": "node scripts/link-self.mjs",
    "test": "node --test test/*.test.js pi/test/*.test.js",
    "lint": "shellcheck bin/ci-local test/fixture/ci-local.config.sh"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
