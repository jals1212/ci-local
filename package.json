{
  "name": "@jals1212/ci-local",
  "version": "0.1.3",
  "description": "Run a Node project's GitHub Actions workflow steps on your machine, in Linux, without touching your development stack, with parity checks that keep the two in step.",
  "license": "MIT",
  "author": "jals1212",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jals1212/ci-local.git"
  },
  "homepage": "https://github.com/jals1212/ci-local#readme",
  "bugs": "https://github.com/jals1212/ci-local/issues",
  "keywords": ["ci", "github-actions", "docker", "local", "workflow", "parity"],
  "type": "module",
  "bin": {
    "ci-local": "bin/ci-local"
  },
  "exports": {
    "./parity": {
      "types": "./parity.d.ts",
      "default": "./parity.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["bin", "docker", "parity.js", "parity.d.ts"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "shellcheck bin/ci-local test/fixture/ci-local.config.sh"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
